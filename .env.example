# Public site URL (SEO / canonical)
NEXT_PUBLIC_SITE_URL=https://logicclothes.ua

# Optional Search Console / Webmaster verification meta tags
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_YANDEX_VERIFICATION=

# PostgreSQL (required)
# Local example:
# DATABASE_URL=postgresql://localhost:5432/logic_clothes
# Hosted example (Neon / Railway / etc):
# DATABASE_URL=postgresql://user:pass@host:5432/logic_clothes?sslmode=require
DATABASE_URL=postgresql://localhost:5432/logic_clothes

# Optional: push local catalog → remote (npm run db:push)
# TARGET_DATABASE_URL=postgresql://user:pass@server:5432/logic_clothes?sslmode=require

# Admin panel (/admin) — required for login
ADMIN_USER=admin
ADMIN_PASS=change-me

# Telegram order notifications (optional — orders still accept without these)
BOT_TOKEN=
CHAT_ID=

# Nova Poshta (optional — address autocomplete works without a key;
# add a personal key from my.novaposhta.ua to raise API limits)
NOVA_POSHTA_API_KEY=
NEXT_PUBLIC_NOVA_POSHTA_API_KEY=

# WayForPay (online payment on checkout)
# WAYFORPAY_MERCHANT_ACCOUNT=
# WAYFORPAY_MERCHANT_SECRET=
# WAYFORPAY_MERCHANT_PASSWORD=
# Domain must match the one registered in WayForPay cabinet
# WAYFORPAY_MERCHANT_DOMAIN=logicclothes.ua
